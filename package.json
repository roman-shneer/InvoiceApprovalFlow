    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "concurrently": "^8.2.2",
        "jest": "^29.7.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.4",
        "typescript": "^5.8.3"
    }
}
